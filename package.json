{
  "name": "shapez-visualizer",
  "version": "0.14.6",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DontMash/shapez-vortex.git"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.5.3",
  "scripts": {
    "prepare:buildings": "pnpm --filter @shapez-vortex/sveltekit run prepare:buildings",
    "prepare:shapes": "pnpm --filter @shapez-vortex/sveltekit run prepare:shapes",
    "dev": "pnpm --filter @shapez-vortex/sveltekit run dev",
    "dev:db": "docker compose -f compose.yml up --build",
    "build": "pnpm --filter @shapez-vortex/sveltekit run build",
    "preview": "pnpm --filter @shapez-vortex/sveltekit run preview",
    "test": "pnpm --filter @shapez-vortex/sveltekit run test",
    "test:coverage": "pnpm --filter @shapez-vortex/sveltekit run test:coverage",
    "check": "pnpm --filter @shapez-vortex/sveltekit run check",
    "lint": "pnpm --filter @shapez-vortex/sveltekit run lint",
    "lint:fix": "pnpm --filter @shapez-vortex/sveltekit run lint:fix",
    "format": "pnpm --filter @shapez-vortex/sveltekit run format",
    "format:fix": "pnpm --filter @shapez-vortex/sveltekit run format:fix",
    "release": "changelogen --release --push"
  },
  "changelog": {
    "templates": {
      "commitMessage": "chore(release): v{{newVersion}} [skip-ci]"
    }
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^9.39.4",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.1",
    "changelogen": "^0.6.2"
  }
}
